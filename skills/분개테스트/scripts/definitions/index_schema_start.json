{
  "$comment": "R2 시작 자료 색인(_색인/시작자료.json) 형식. audit/start.py 가 쓰고 조서 생성 · 상태 화면이 읽는다. 숫자는 엔진이 표 칸 · 엑셀 셀에서 읽은 값만 들어간다. 글 항목(감사인 · 의견 · 업종)을 엔진이 못 찾으면 null 로 두고 need_ai 에 남기며, AI · 사람 판독은 ai 목록으로만 들어온다(python -m audit start <폴더> --apply).",
  "시작자료.json": {
    "type": "object",
    "required": ["format_version", "made_at", "prior_end", "company", "prior_report", "dart", "prior_workpapers", "prior_fs", "need_ai", "warnings", "ai", "made", "parties", "changes", "pbc"],
    "additionalProperties": false,
    "properties": {
      "format_version": {"const": 1},
      "made_at": {"type": "string"},
      "prior_end": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
      "company": {
        "type": "object",
        "required": ["name", "dart_corp_code", "industry", "basis"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "dart_corp_code": {"type": ["string", "null"], "pattern": "^[0-9]{8}$"},
          "industry": {"type": ["string", "null"]},
          "industry_basis": {"type": ["string", "null"]},
          "framework": {"type": ["string", "null"]},
          "basis": {"type": "string"},
          "overview": {"type": ["string", "null"]}
        }
      },
      "prior_report": {
        "type": ["object", "null"],
        "required": ["path", "format", "auditor", "opinion", "emphasis", "figures", "basis", "need_ai"],
        "properties": {
          "path": {"type": "string"},
          "format": {"enum": ["PDF", "DART"]},
          "company": {"type": ["string", "null"]},
          "auditor": {"type": ["string", "null"]},
          "opinion": {"enum": ["적정", "한정", "부적정", "의견거절", null]},
          "emphasis": {"type": ["boolean", "null"]},
          "going_concern": {"type": ["boolean", "null"]},
          "report_date": {"type": ["string", "null"]},
          "fiscal_year_end": {"type": ["string", "null"]},
          "framework": {"type": ["string", "null"]},
          "figures": {"type": "object", "additionalProperties": {"type": "integer"}},
          "figure_pages": {"type": "object", "additionalProperties": {"type": "string"}},
          "basis": {"type": "object", "additionalProperties": {"enum": ["엔진", "AI", "사람", "판독 필요"]}},
          "need_ai": {"type": "array", "items": {"type": "string"}}
        }
      },
      "dart": {
        "type": ["object", "null"],
        "required": ["path", "opinion", "auditor", "key_bs", "key_is"],
        "properties": {
          "path": {"type": "string"},
          "source": {"type": ["string", "null"]},
          "rcp_no": {"type": ["string", "null"], "pattern": "^[0-9]{14}$"},
          "corp_code": {"type": ["string", "null"], "pattern": "^[0-9]{8}$"},
          "opinion": {"enum": ["적정", "한정", "부적정", "의견거절", null]},
          "auditor": {"type": ["string", "null"]},
          "key_bs": {"type": "object", "additionalProperties": {"type": ["integer", "null"]}},
          "key_is": {"type": "object", "additionalProperties": {"type": ["integer", "null"]}},
          "diffs_vs_report": {"type": "array", "items": {"type": "string"}}
        }
      },
      "prior_workpapers": {
        "type": ["object", "null"],
        "required": ["materiality", "adjustments", "unadjusted", "wtb", "files", "need_ai"],
        "properties": {
          "materiality": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "overall": {"$ref": "#/$defs/mat"},
              "performance": {"$ref": "#/$defs/mat"},
              "trivial": {"$ref": "#/$defs/mat"}
            }
          },
          "adjustments": {"type": "array", "items": {"$ref": "#/$defs/adj"}},
          "unadjusted": {"type": "array", "items": {"$ref": "#/$defs/adj"}},
          "wtb": {"type": "object"},
          "files": {"type": "object"},
          "need_ai": {"type": "array", "items": {"type": "string"}}
        }
      },
      "prior_fs": {
        "type": ["object", "null"],
        "required": ["as_of", "bs", "is", "source", "basis"],
        "properties": {
          "as_of": {"type": ["string", "null"]},
          "bs": {"type": "object", "additionalProperties": {"type": "number"}},
          "is": {"type": "object", "additionalProperties": {"type": "number"}},
          "source": {"type": "string"},
          "basis": {"enum": ["전기 재무제표 엑셀", "전기조서 8100B 최종 열", "DART 감사보고서 재무제표", "전기 감사보고서 요약"]}
        }
      },
      "need_ai": {"type": "array", "items": {"type": "string"}},
      "warnings": {"type": "array", "items": {"type": "string"}},
      "term": {
        "type": ["object", "null"],
        "description": "당기 기수. 작년 감사 폴더 감사건 → 전기 감사보고서 · DART 「제 N 기」 + 1. 못 찾으면 null(2026-10-06)",
        "properties": {"current": {"type": "integer"}, "prior": {"type": ["integer", "null"]}, "basis": {"type": "string"}}
      },
      "ai": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["field", "value", "basis"],
          "additionalProperties": false,
          "properties": {
            "field": {"enum": ["prior_report.auditor", "prior_report.opinion", "prior_report.emphasis", "prior_report.going_concern", "prior_report.report_date", "company.industry"]},
            "value": {"type": ["string", "boolean"]},
            "basis": {"enum": ["AI", "사람"]},
            "source_page": {"type": ["string", "null"]}
          }
        }
      },
      "made": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "description": "엔진이 쓴 조서 파일 이름 → 해시. 해시가 같으면 손대지 않은 초안이라 다시 쓴다"},
      "parties": {"type": "object"},
      "changes": {"type": "object", "required": ["rows", "threshold"]},
      "pbc": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["no", "item", "status"],
          "additionalProperties": false,
          "properties": {"no": {"type": "integer"}, "item": {"type": "string"}, "status": {"type": "string"}}
        }
      },
      "dart_saved": {"type": "string"},
      "prior_source": {
        "type": "object",
        "description": "R7 전기 자료(audit/prior.py collect). 작년 감사 폴더 · 전임 전기조서 · 전기조서 없음 가운데 어느 상황인지와 이어받을 전기 판단 정보. 숫자는 엔진이 조서 · 받은자료에서 읽은 값만",
        "required": ["situation", "prior_audited", "engagement_dir", "materiality", "unadjusted", "opinion", "carry", "inputs", "account_prior"],
        "properties": {
          "situation": {"enum": ["작년 폴더", "전임 전기조서", "전기조서 없음"]},
          "prior_audited": {"type": ["boolean", "null"]},
          "audited_basis": {"type": ["string", "null"]},
          "engagement_dir": {"type": ["string", "null"]},
          "archived": {"type": "boolean"},
          "materiality": {"type": ["object", "null"]},
          "unadjusted": {"type": "array", "items": {"type": "object", "required": ["text", "amount", "source"],
                                                    "properties": {"text": {"type": "string"}, "amount": {"type": "integer"}, "source": {"type": "string"}}}},
          "opinion": {"type": ["object", "null"]},
          "carry": {"type": "array", "items": {"type": "object", "required": ["what", "text", "source"], "additionalProperties": false,
                                               "properties": {"what": {"type": "string"}, "text": {"type": "string"}, "source": {"type": "string"}}}},
          "inputs": {"type": "object", "additionalProperties": {"type": "string"}},
          "account_prior": {"type": ["object", "null"], "required": ["basis_counts", "missing_pl"],
                            "properties": {"basis_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
                                           "missing_pl": {"type": "boolean"}}},
          "workpapers": {"type": "array", "items": {"type": "string"}},
          "warnings": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "$defs": {
      "mat": {
        "type": "object",
        "required": ["amount", "path"],
        "properties": {"amount": {"type": "integer"}, "basis": {"type": ["string", "null"]}, "sheet": {"type": "string"}, "path": {"type": "string"}}
      },
      "adj": {
        "type": "object",
        "required": ["text", "amount", "path"],
        "properties": {"text": {"type": "string"}, "amount": {"type": "integer"}, "path": {"type": "string"}}
      }
    }
  }
}
