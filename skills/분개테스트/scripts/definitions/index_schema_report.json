{
  "$comment": "R4 보고 단계 색인(2026-10-05). audit/report 가 make · check 때 쓴다. 숫자는 엔진 값, decisions 는 8100A 감사인 기입값을 옮긴 것이다.",
  "보고.json": {
    "type": "object",
    "required": ["format_version", "made_at", "checked_at", "materiality", "decisions", "adjustments", "statements", "footing"],
    "additionalProperties": false,
    "properties": {
      "format_version": {"const": 1},
      "made_at": {"type": "string"},
      "checked_at": {"type": "string"},
      "company_version": {"type": ["string", "null"]},
      "materiality": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "overall": {"type": ["number", "null"]},
          "performance": {"type": ["number", "null"]},
          "trivial": {"type": ["number", "null"]},
          "source": {"type": ["string", "null"], "description": "2700A 경로 또는 '8100A 기입'. 없으면 null"}
        }
      },
      "decisions": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["issue", "decision"],
          "additionalProperties": false,
          "properties": {
            "issue": {"type": "integer"},
            "decision": {"type": ["string", "null"]},
            "reason": {"type": ["string", "null"]}
          }
        }
      },
      "adjustments": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["code", "dr", "cr"],
          "additionalProperties": false,
          "properties": {
            "issue": {"type": ["integer", "null"]},
            "code": {"type": "string"},
            "dr": {"type": "integer"},
            "cr": {"type": "integer"}
          }
        }
      },
      "unadjusted_summary": {"type": "object", "additionalProperties": {"type": "integer"}},
      "statements": {"type": "object", "additionalProperties": {"type": "integer"}},
      "problems": {"type": "array", "items": {"type": "string"}},
      "footing": {"$ref": "#/$defs/result"},
      "dart_review": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/result"}]},
      "files": {"type": "array", "items": {"type": "string"}},
      "kept": {"type": "array", "items": {"type": "string"}, "description": "회계사가 고쳐서 다시 만들지 않은 문서"},
      "dart_ready": {
        "description": "DART 제출 준비(2026-10-06). 8600 감사의견 선택 · 8400 공시 점검 · 남은 기입 칸. ready 가 거짓이면 DART 초안 맨 위에 검토 전 상자가 붙는다",
        "oneOf": [{"type": "null"}, {
          "type": "object",
          "required": ["opinion", "opinion_problems", "notes_open", "notes_excluded", "marks", "html_warning", "ready"],
          "additionalProperties": false,
          "properties": {
            "opinion": {"enum": ["적정", "한정", "부적정", "의견거절", null]},
            "opinion_problems": {"type": "array", "items": {"type": "string"}},
            "notes_open": {"type": "array", "items": {"type": "integer"}},
            "notes_excluded": {"type": "array", "items": {"type": "integer"}},
            "marks": {"type": "integer"},
            "html_warning": {"type": "boolean"},
            "ready": {"type": "boolean"}
          }
        }]
      }
    },
    "$defs": {
      "result": {
        "type": "object",
        "required": ["일치", "불일치", "확인", "items"],
        "additionalProperties": false,
        "properties": {
          "일치": {"type": "integer"},
          "불일치": {"type": "integer"},
          "확인": {"type": "integer"},
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["area", "where", "item", "result"],
              "additionalProperties": false,
              "properties": {
                "area": {"type": "string"}, "where": {"type": "string"}, "item": {"type": "string"},
                "doc": {"type": ["number", "null"]}, "ref": {"type": ["number", "null"]}, "diff": {"type": ["number", "null"]},
                "result": {"enum": ["일치", "불일치", "확인"]}
              }
            }
          }
        }
      }
    }
  }
}
