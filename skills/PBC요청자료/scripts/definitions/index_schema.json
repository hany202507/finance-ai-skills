{
  "$comment": "감사 폴더 _색인 파일 네 개의 형식(R0, 2026-10-05). 에이전트가 쓰고 상태 화면·지휘 스킬이 읽는다. 정본은 Drive 의 원본 파일이고 이 파일들은 다시 만들 수 있는 사본이다. 판별 근거 kind_basis: 폴더(받은자료 하위 폴더), 파일명(규칙), 엔진(결정적 파서), AI(AI 판독, confirmed=false 로 시작). 숫자 사실은 엔진 판독만 쓴다.",
  "감사건.json": {
    "type": "object",
    "required": ["format_version", "company", "fiscal_year_end", "engagement_kind", "company_version", "stage", "indexed_at", "next_actions", "log"],
    "additionalProperties": false,
    "properties": {
      "format_version": {"const": 1},
      "company": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "dart_corp_code": {"type": ["string", "null"], "pattern": "^[0-9]{8}$"},
          "industry": {"type": ["string", "null"]},
          "basis": {"type": "string", "description": "회사 정보 출처(폴더 이름, DART, 전기 감사보고서)"}
        }
      },
      "fiscal_year_end": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
      "term": {
        "type": "object",
        "required": ["current"],
        "additionalProperties": false,
        "description": "당기 기수(제 N 기). 시작 자료(작년 감사 폴더 · 전기 감사보고서 · DART)의 전기 기수 + 1. 못 읽으면 이 항목이 없다(2026-10-06)",
        "properties": {
          "current": {"type": "integer", "minimum": 1},
          "prior": {"type": ["integer", "null"]},
          "basis": {"type": "string"}
        }
      },
      "fiscal_year_start": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "반기 · 짧은 사업연도의 시작일(R8). 없으면 결산일 1년 전 다음 날"},
      "half_year_end": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "반기 기준일(2026-10-18). 있으면 PBC 양식에 그 반기 요청 줄을 낸다. 없으면 결산 연도 기준 문구만 쓴다"},
      "engagement_kind": {"enum": ["초도감사", "계속감사"]},
      "company_version": {"type": ["string", "null"], "pattern": "^v[0-9]+\\.[0-9]+$", "description": "지금 회사제시 판. 회사제시 파일이 없으면 null"},
      "stage": {"enum": ["준비", "계획", "실행", "보고", "종결"]},
      "indexed_at": {"type": "string"},
      "next_actions": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["who", "title"],
          "additionalProperties": false,
          "properties": {
            "who": {"enum": ["회계사", "스킬", "회사", "감사반"]},
            "title": {"type": "string"},
            "detail": {"type": "string"},
            "skill": {"type": "string"},
            "workpaper": {"type": "string"},
            "assignee": {"type": "string", "description": "관련 조서의 담당자. 검토 요청은 검토자(2026-10-12)"}
          }
        }
      },
      "log": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["at", "who", "what"],
          "additionalProperties": false,
          "properties": {
            "at": {"type": "string"},
            "who": {"type": "string"},
            "what": {"type": "string"},
            "read": {"type": "array", "items": {"type": "string"}},
            "wrote": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  },
  "문서목록.json": {
    "type": "object",
    "required": ["format_version", "indexed_at", "files", "missing"],
    "additionalProperties": false,
    "properties": {
      "format_version": {"const": 1},
      "indexed_at": {"type": "string"},
      "files": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["path", "sha256", "size", "modified", "role", "kind", "kind_basis", "confirmed"],
          "additionalProperties": false,
          "properties": {
            "path": {"type": "string", "description": "감사 폴더 기준 상대 경로, / 구분"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "size": {"type": "integer", "minimum": 0},
            "modified": {"type": "string"},
            "role": {"enum": ["received", "workpapers", "permanent", "archive", "unknown"]},
            "folder_kind": {"type": ["string", "null"], "description": "받은자료 하위 폴더 이름"},
            "kind": {"type": "string"},
            "kind_basis": {"enum": ["폴더", "파일명", "엔진", "AI"]},
            "confirmed": {"type": "boolean"},
            "version": {"type": ["string", "null"], "pattern": "^v[0-9]+\\.[0-9]+$"},
            "period": {"type": ["string", "null"]},
            "workpaper": {"type": ["string", "null"], "description": "조서 파일이면 조서번호"},
            "facts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["text", "basis"],
                "additionalProperties": false,
                "properties": {
                  "text": {"type": "string"},
                  "basis": {"enum": ["엔진", "AI"]},
                  "source_page": {"type": "string"},
                  "value": {"type": ["number", "null"]},
                  "source": {"enum": ["ocr"], "description": "OCR(kordoc) 저장본 글에서 엔진이 읽은 사실(2026-10-18). 숫자 · 날짜는 확인 전이다"},
                  "confirmed": {"type": "boolean", "description": "사실 하나의 확인 여부. OCR 사실은 false 로 둔다"}
                }
              }
            },
            "linked_workpapers": {"type": "array", "items": {"type": "string"}},
            "read_error": {"type": "string", "description": "엔진 판독 종류인데 사실을 내지 못한 까닭(R8). 판독되면 지운다"},
            "ocr_confirmed": {
              "type": "array",
              "description": "회계사가 쪽 그림과 대조해 확인한 OCR 값(2026-10-18, index apply 의 ocr_confirm). 파일 해시(sha256)가 같을 때만 쓴다. 분석이 이 값을 대사 · 이슈에 쓰고 ocr_checks 에서 뺀다",
              "items": {"type": "object", "required": ["item", "value", "by", "at", "sha256"], "additionalProperties": false,
                        "properties": {"item": {"type": "string"}, "value": {"type": "number"}, "by": {"type": "string"},
                                       "at": {"type": "string"}, "sha256": {"type": "string"}}}
            },
            "needs_recheck": {"type": "boolean", "description": "사람 · AI 판독을 넣은 뒤 파일 해시가 바뀐 영구조서. 앞 판독은 남기고 확인 전으로 둔다. index apply 로 다시 판독하거나 사람이 확인하면 지운다(2026-10-18)"}
          }
        }
      },
      "missing": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["item"],
          "additionalProperties": false,
          "properties": {
            "item": {"type": "string"},
            "workpaper": {"type": "string"},
            "issue": {"type": ["integer", "null"]},
            "requested_at": {"type": ["string", "null"]},
            "source": {"enum": ["분석"], "description": "분석.json requests 에서 온 줄(2026-10-18). 요청자료 줄과 겹치지 않는 분석 요청"},
            "detail": {"type": "array", "items": {"type": "string"}, "description": "분석이 붙인 구체 문구(잔액증명 기준일 · 약정서 없는 차입처 · 주주명부 기준일 등)"},
            "rules": {"type": "array", "items": {"type": "string"}, "description": "그 요청을 남긴 분석 규칙 id"}
          }
        }
      },
      "warnings": {"type": "array", "items": {"type": "string"}}
    }
  },
  "조서목록.json": {
    "type": "object",
    "required": ["format_version", "workpapers"],
    "additionalProperties": false,
    "properties": {
      "format_version": {"const": 1},
      "workpapers": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["no", "name", "folder", "status"],
          "additionalProperties": false,
          "properties": {
            "no": {"type": "string"},
            "name": {"type": "string"},
            "folder": {"type": "string"},
            "file": {"type": ["string", "null"]},
            "sha256": {"type": ["string", "null"]},
            "version": {"type": ["string", "null"]},
            "status": {"enum": ["없음", "초안", "작성중", "검사 통과", "검토 끝"]},
            "status_basis": {"type": "string", "description": "상태를 정한 근거(파일 있음, 검사 결과, 검토 시트 등)"},
            "signs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "작성": {"type": ["object", "null"], "properties": {"by": {"type": "string"}, "at": {"type": "string"}}},
                "검토": {"type": ["object", "null"], "properties": {"by": {"type": "string"}, "at": {"type": "string"}}}
              }
            },
            "why": {"type": "string", "description": "생긴 이유: 필수 또는 이슈 번호"},
            "needs_recheck": {"type": "boolean"},
            "assign": {
              "type": "object",
              "additionalProperties": false,
              "description": "스태프 배정(_색인/배정.json 을 scan 이 옮긴 것, 2026-10-12)",
              "properties": {"to": {"type": "string"}, "reviewer": {"type": "string"}, "due": {"type": "string"}}
            }
          }
        }
      }
    }
  },
  "이슈.json": {
    "type": "object",
    "required": ["format_version", "issues"],
    "additionalProperties": false,
    "properties": {
      "format_version": {"const": 1},
      "issues": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["no", "source", "origin_wp", "title", "status"],
          "additionalProperties": false,
          "properties": {
            "no": {"type": "integer", "minimum": 1},
            "source": {"enum": ["분석적 변동", "자료 불일치", "주요 회계처리", "절차 예외"]},
            "origin_wp": {"type": "string"},
            "area": {"type": ["string", "null"]},
            "account": {"type": ["string", "null"]},
            "assertions": {"type": "array", "items": {"enum": ["E/O", "C", "A/V", "CO", "RO", "P/CL"]}},
            "amount": {"type": ["integer", "null"]},
            "title": {"type": "string"},
            "response_wp": {"type": ["string", "null"]},
            "status": {"enum": ["열림", "닫힘"]},
            "close_method": {"enum": ["수정분개", "설명 종결", "미수정 왜곡표시", null]},
            "conclusion": {"type": ["string", "null"]}
          }
        }
      }
    }
  }
}
