{
  "$comment": "R3 분석적 검토 · 주요 회계처리 결과 _색인/분석.json 형식(2026-10-05). audit/analysis 가 쓰고 상태 화면 · 지휘 · 감사-분석적검토 스킬(AI 메모)이 읽는다. 숫자는 모두 엔진 계산값이다. memo 만 AI 가 쓰고 audit.analysis.memo.validate 를 통과한 것만 들어온다(basis AI, confirmed false). issue_links 는 엔진이 만든 이슈 번호와 영역 · 계정을 이어 같은 자료로 다시 돌려도 이슈가 늘지 않게 한다.",
  "분석.json": {
    "type": "object",
    "required": ["format_version", "analyzed_at", "company_version", "period", "sources", "inputs", "missing_inputs", "accounts", "unmapped",
                 "lines", "ratios", "recons", "expectations", "variances", "relations", "monthly", "signals", "patterns", "minutes",
                 "key_transactions", "tax_clues", "materiality_bases", "totals", "areas_with_amounts", "findings", "issues", "below_top",
                 "issue_links", "adjustments", "skipped", "memo", "log"],
    "additionalProperties": false,
    "$defs": {
      "num": {"type": ["number", "null"]},
      "assertions": {"type": "array", "items": {"enum": ["E/O", "C", "A/V", "CO", "RO", "P/CL"]}}
    },
    "properties": {
      "format_version": {"const": 1},
      "analyzed_at": {"type": "string"},
      "company_version": {"type": ["string", "null"]},
      "period": {
        "type": "object",
        "required": ["fy_start", "fy_end", "prior_end", "days", "months"],
        "properties": {"fy_start": {"type": "string"}, "fy_end": {"type": "string"}, "prior_end": {"type": "string"},
                       "days": {"type": "integer"}, "months": {"type": "array", "items": {"type": "string"}}}
      },
      "sources": {"type": "object", "description": "읽은 받은자료 경로(시산표 · 분개장 · 전기 재무제표 · 세무신고 · 약정서 · 잔액증명 · 의사록)"},
      "prior": {"type": "object", "description": "R7 전기 자료(audit/prior.py): 상황 · 계정 단위 전기 잔액 출처 분포(basis_counts) · 손익 원천 없음(missing_pl) · 원천 목록 · 원천 사이 차이"},
      "inputs": {
        "type": "object",
        "description": "감사인 입력값과 빈 칸을 채운 방법론 기본값(default: true, 2026-10-07). 값이 어느 조서 기입란 또는 어떤 기본값에서 왔는지 함께 남긴다. 중요성 기준은 글자",
        "additionalProperties": {"type": "object", "required": ["value", "from"],
                                 "properties": {"value": {"type": ["number", "string"]}, "from": {"type": "string"},
                                                "default": {"type": "boolean"}}}
      },
      "missing_inputs": {"type": "array", "items": {"type": "string"}},
      "default_inputs": {"type": "array", "items": {"type": "string"}, "description": "방법론 기본값으로 채운 입력 키(감사인 확인 대상)"},
      "accounts": {
        "type": "array",
        "items": {"type": "object", "required": ["code", "name", "line", "id", "area", "section", "cur", "prior"],
                  "properties": {"code": {"type": "string"}, "name": {"type": "string"}, "line": {"type": "string"},
                                 "id": {"type": ["string", "null"]}, "area": {"type": ["string", "null"]},
                                 "section": {"type": ["string", "null"]}, "cur": {"type": "number"}, "prior": {"$ref": "#/$defs/num"}}}
      },
      "unmapped": {"type": "array", "items": {"type": "object", "required": ["code", "name"]}},
      "prior_unpaired": {"type": "object", "description": "전기 재무제표 과목과 당기 표시과목 가운데 짝이 없는 것(2026-10-15). current 는 당기 금액만 있는 표시과목, prior 는 전기 금액만 있는 전기 과목. AI 가 뜻으로 짝을 _색인/전기과목짝.json 에 적는다",
        "properties": {"current": {"type": "array"}, "prior": {"type": "array"}}},
      "lines": {
        "type": "array",
        "description": "비교 줄: 당기 표시과목과 전기 재무제표 과목을 이름 맞춤으로 묶은 줄(accounts.yaml)",
        "items": {"type": "object", "required": ["label", "stmt", "codes", "cur", "prior_fs", "prior_derived", "prior_labels"],
                  "properties": {"stmt": {"enum": ["BS", "IS"]}, "codes": {"type": "array", "items": {"type": "string"}}}}
      },
      "ratios": {"type": "array", "items": {"type": "object", "required": ["id", "title", "cur", "prior", "change"]}},
      "recons": {
        "type": "array",
        "description": "자료 사이 대사. 차이 0 인 것도 모두 남긴다",
        "items": {"type": "object", "required": ["id", "title", "period", "left", "right", "diff", "refs", "independent"],
                  "properties": {"period": {"enum": ["cur", "prior"]}, "left": {"type": "number"}, "right": {"type": "number"},
                                 "diff": {"type": "number"}, "refs": {"type": "array", "items": {"type": "string"}}}}
      },
      "requests": {
        "type": "array",
        "description": "대사하지 못해 필요한 자료(2026-10-18): 잔액증명 기준일이 결산일과 다름 · 잔액증명 없는 금융기관 · 약정서 없는 차입처 · 약정서가 덮는 범위 확인. rules 는 그 글을 남긴 대사 규칙 id",
        "items": {"type": "object", "required": ["rules", "what"],
                  "properties": {"rules": {"type": "array", "items": {"type": "string"}}, "what": {"type": "string"}, "why": {"type": ["string", "null"]}}}
      },
      "ocr_checks": {
        "type": "array",
        "description": "OCR(kordoc) 저장본 글에서 엔진이 읽었으나 확인 전인 값(2026-10-18). 대사 · 이슈 금액에 쓰지 않는다. 지휘가 회계사 확인 줄로 낸다",
        "items": {"type": "object", "required": ["kind", "path", "what"],
                  "properties": {"kind": {"type": "string"}, "path": {"type": "string"}, "page": {"type": ["string", "integer", "null"]},
                                 "what": {"type": "string"}}}
      },
      "equity": {
        "type": ["object", "null"],
        "description": "주주명부 판독과 자본 분석(2026-10-18, audit/analysis/equity.py): 기준일 판정(status), 주식수 × 액면가 ↔ 자본금(capital), 기준일 뒤 자본 변동(after), 전기 비교(prior), 특수관계자 후보(related)"
      },
      "fx": {
        "type": ["object", "null"],
        "description": "외화 화폐성 항목 결산일 환율 환산 재계산(2026-10-20, audit/analysis/fx.py): 통화(currencies), 결산일 환율과 근거(rates), 항목(items: 외화 금액 · 장부 원화 · 기대값 · 차이), 통화별 합(by_currency), 외화 금액 출처(source), 외화 금액을 모르는 외화 거래처(uncovered), 외화환산 손익 계정(income)"
      },
      "party_balances": {
        "type": "object",
        "description": "계정명세서 거래처별 잔액(2026-10-18): 시트와 시산표 맞춤(sheets), 계정 방향과 반대인 잔액(opposite), 같은 거래처 상계 후보(offsets). 확인 후보이고 판단은 회계사",
        "properties": {"sheets": {"type": "array"}, "opposite": {"type": "array"}, "offsets": {"type": "array"}}
      },
      "vat_periods": {
        "type": "array",
        "description": "부가세 신고서마다 신고 기간의 분개장 매출과 신고 과세표준 대사(2026-10-16). 이슈 · Finding 은 만들지 않는다",
        "items": {"type": "object", "required": ["start", "end", "left", "right", "diff", "ref"]}
      },
      "expectations": {"type": "array", "items": {"type": "object", "required": ["id", "title", "expected", "actual", "diff"]}},
      "variances": {
        "type": "array",
        "items": {"type": "object", "required": ["code", "cur", "prior", "change", "over", "expected", "explained_by", "unexplained"]}
      },
      "relations": {"type": "array", "items": {"type": "object", "required": ["id", "title", "fired"]}},
      "monthly": {"type": "object"},
      "signals": {
        "type": "object",
        "additionalProperties": {"anyOf": [{"type": "null"},
                                           {"type": "object", "required": ["fired", "amount", "metric"],
                                            "properties": {"fired": {"type": "boolean"}, "amount": {"type": "integer"}}}]}
      },
      "patterns": {"type": "array", "items": {"type": "object", "required": ["id", "title", "area", "signals_on", "amount"]}},
      "minutes": {
        "type": "array",
        "items": {"type": "object",
                  "required": ["id", "file", "meeting", "date", "agenda", "topic", "amount", "counterparty", "source", "basis", "confirmed", "match_status", "matched_vouchers"],
                  "properties": {"amount": {"type": ["integer", "null"]}, "confirmed": {"type": "boolean"},
                                 "match_status": {"enum": ["matched", "unmatched", "no_ledger_expected", "amount_unknown", "주제 확인 필요"]}}}
      },
      "key_transactions": {"type": "array", "items": {"type": "object", "required": ["id", "voucher", "date", "amount", "accounts", "area", "rules", "lines"]}},
      "tax_clues": {"type": "array"},
      "materiality_bases": {"type": "array", "items": {"type": "object", "required": ["name", "cur", "prior", "pct_low", "pct_high"]}},
      "totals": {"type": "object"},
      "areas_with_amounts": {"type": "array", "items": {"type": "string"}},
      "findings": {
        "type": "array",
        "items": {"type": "object", "required": ["id", "kind", "rule_id", "title", "area", "accounts", "assertions", "amount", "metric", "refs", "score"],
                  "properties": {"kind": {"enum": ["variance", "monthly", "recon", "expectation", "relation", "pattern", "keytx", "balance"]},
                                 "amount": {"type": "integer", "minimum": 0}, "assertions": {"$ref": "#/$defs/assertions"}}}
      },
      "issues": {
        "type": "array",
        "description": "이번 실행의 상위 이슈(순위순). issue 는 _색인/이슈.json 의 no",
        "items": {"type": "object", "required": ["rank", "issue", "score", "area", "accounts", "source", "title", "amount", "assertions", "findings"],
                  "properties": {"issue": {"type": "integer", "minimum": 1},
                                 "source": {"enum": ["분석적 변동", "자료 불일치", "주요 회계처리", "절차 예외"]},
                                 "assertions": {"$ref": "#/$defs/assertions"}}}
      },
      "below_top": {"type": "array"},
      "issue_links": {
        "type": "array",
        "items": {"type": "object", "required": ["no", "area", "accounts"],
                  "properties": {"no": {"type": "integer"}, "area": {"type": "string"}, "accounts": {"type": "array", "items": {"type": "string"}}}}
      },
      "adjustments": {
        "type": "array",
        "description": "증거에서 금액이 정해지는 수정 후보. 반영 여부는 회계사가 8100B 수정 제안 시트 기입란에 적는다",
        "items": {"type": "object", "required": ["issue", "title", "basis", "lines"],
                  "properties": {"lines": {"type": "array", "items": {"type": "object", "required": ["code", "name", "dr", "cr"]}}}}
      },
      "skipped": {"type": "array", "items": {"type": "string"}},
      "memo": {
        "anyOf": [{"type": "null"},
                  {"type": "object", "required": ["hypotheses", "items", "basis", "confirmed", "validated_at"],
                   "properties": {"basis": {"const": "AI"}, "confirmed": {"type": "boolean"}}}]
      },
      "log": {"type": "array", "items": {"type": "string"}},
      "trend": {
        "type": "object",
        "description": "R9 묶음 B1: 전전기 이전 재무제표(작년 감사 폴더 8810 전기 열 · 전기 재무제표 비교 열)와 표시과목마다의 값. 2120A 추이 시트",
        "required": ["years", "lines"],
        "properties": {"years": {"type": "array", "items": {"type": "object", "required": ["key", "label", "path", "basis"]}},
                       "lines": {"type": "object"}}
      },
      "disclosure": {
        "type": ["object", "null"],
        "description": "설계 4.4(2026-10-09): 공시 꼴 재무제표 양식의 과목마다 당기 · 전기 · 증감 · 구성비. 양식은 받은자료에서 세우고(fslayout), 전기는 공시 재무제표의 전기 열(차감 줄은 음수). 2120A 「공시 과목 증감」 시트",
        "required": ["basis", "rows"],
        "properties": {"basis": {"type": "string"}, "source_path": {"type": ["string", "null"]}, "coa": {"type": ["string", "null"]},
                       "rolled": {"type": "array"}, "unmatched_accounts": {"type": "array"}, "base": {"type": "object"},
                       "rows": {"type": "array", "items": {"type": "object",
                                "required": ["kind", "label", "key", "stmt", "codes", "cur", "prior", "change", "change_ratio", "share_cur", "share_prior"],
                                "properties": {"kind": {"enum": ["section", "h1", "h2", "acct", "total"]}, "stmt": {"enum": ["bs", "is"]},
                                               "codes": {"type": "array", "items": {"type": "string"}},
                                               "cur": {"$ref": "#/$defs/num"}, "prior": {"$ref": "#/$defs/num"}}}}}
      },
      "mfg_cost": {
        "type": "object",
        "description": "R9 묶음 B1: 제조원가 계정(501~799) 구성과 매출원가 연결(재공품 · 제품 잔액이 있을 때만 link). 2120A 제조원가 시트",
        "required": ["accounts", "link"],
        "properties": {"accounts": {"type": "array"}, "link": {"type": ["object", "null"]}, "link_missing": {"type": "array"}}
      }
    }
  },
  "전기과목짝.json": {
    "type": "object",
    "description": "전기 과목 ↔ 당기 표시과목 짝(2026-10-15). 엔진의 이름 · 계정 사전 짝이 못 이은 과목을 AI 가 뜻으로 적는다. 확인은 회계사(confirmed)",
    "required": ["format_version", "pairs"],
    "properties": {
      "format_version": {"const": 1},
      "pairs": {"type": "array", "items": {"type": "object", "required": ["stmt", "prior", "line", "why", "confirmed"],
        "properties": {"stmt": {"enum": ["BS", "IS"]}, "prior": {"type": "string"}, "line": {"type": "string"},
                       "why": {"type": "string", "minLength": 1}, "by": {"type": "string"}, "confirmed": {"type": "boolean"}}}}
    }
  }
}
